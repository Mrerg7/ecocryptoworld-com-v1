---
import { getCollection, getEntry } from 'astro:content';
import AcquisitionCTA from '../components/AcquisitionCTA.astro';
import FAQ from '../components/FAQ.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import Nav from '../components/Nav.astro';
import OfferForm from '../components/OfferForm.astro';
import StickyCta from '../components/StickyCta.astro';
import { DOMAIN_PRICE, SITE } from '../consts';
import BaseLayout from '../layouts/BaseLayout.astro';

const siteEntry = await getEntry('site', 'default');
if (!siteEntry) throw new Error('Site config missing');
const siteConfig = siteEntry.data;

const reasons = (await getCollection('reasons')).sort(
  (a, b) => a.data.number - b.data.number,
);
---

<BaseLayout>
  <Nav />

  <main>
    <!-- HERO -->
    <header class="hero-bg min-h-[100dvh] flex items-center pt-16 relative">
      <div class="max-w-screen-xl mx-auto px-6 pt-12 pb-20 w-full">
        <div class="max-w-5xl lg:max-w-2xl">
          <!-- Badge -->
          <div class="inline-flex items-center gap-x-2 px-4 py-1.5 rounded-3xl bg-white/10 backdrop-blur-md border border-white/20 mb-8">
            <div class="flex items-center gap-x-1.5">
              <div class="w-2 h-2 bg-emerald-400 rounded-full animate-pulse"></div>
              <span class="text-emerald-300 text-xs font-semibold tracking-[1.5px] uppercase">Premium .com • Available Now</span>
            </div>
          </div>

          <div class="max-w-4xl">
            <h1 class="font-display text-[2.75rem] sm:text-[4rem] md:text-[5.5rem] leading-[0.95] tracking-[-1.5px] sm:tracking-[-3px] md:tracking-[-4px] font-extrabold mb-2">
              Own the Brand<br />of the<br />
              <span class="eco-gradient">Eco Crypto World</span>
            </h1>

            <div class="flex flex-wrap items-baseline gap-x-3 gap-y-2 mb-6">
              <span class="font-mono text-3xl md:text-4xl text-emerald-400 font-semibold tracking-[-2px] [overflow-wrap:anywhere]">{SITE.name}</span>
              <span class="text-sm text-zinc-300 tabular-nums">
                Listed at <strong class="text-white font-semibold">{DOMAIN_PRICE.display} USD</strong>
              </span>
            </div>

            <p class="max-w-2xl text-xl md:text-2xl text-zinc-300 font-light tracking-tight leading-tight mb-10">
              The definitive premium domain for the future of sustainable wealth, regenerative finance, and planetary impact.
            </p>
          </div>

          <div class="flex flex-col sm:flex-row items-start sm:items-center gap-4">
            <AcquisitionCTA label="Make an offer" variant="accent" icon="arrow-right" href="#offer" />
            <a href="#opportunity" class="px-8 py-4 border border-white/30 hover:bg-white/5 active:bg-white/10 transition-all font-semibold text-lg rounded-3xl flex items-center justify-center gap-x-2 w-full sm:w-auto text-white no-underline">
              <span>Explore the Opportunity</span>
            </a>
          </div>

          <div class="mt-10 flex flex-wrap items-center gap-x-8 gap-y-3 text-sm">
            <div class="flex items-center gap-x-2 text-zinc-300">
              <Icon name="check" class="w-4 h-4 text-emerald-400" />
              <span>Escrow-protected closing</span>
            </div>
            <div class="flex items-center gap-x-2 text-zinc-300">
              <Icon name="check" class="w-4 h-4 text-emerald-400" />
              <span>Global + Regenerative brand</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Hero Visual -->
      <div class="hidden lg:block absolute right-8 top-1/2 -translate-y-1/2 w-full max-w-lg">
        <div class="relative rounded-3xl overflow-hidden border border-zinc-700/50 shadow-2xl" style="box-shadow: 0 0 40px rgba(16, 185, 129, 0.15);">
          <img
            src="https://imagedelivery.net/-sPAUAWeA405NiWJ0SNIQA/d7753631-936b-4121-4c3f-fa95f9393600/public"
            alt="Lush sustainable crypto world — Earth with regenerative green landscapes, glowing blockchain networks, and crypto symbols integrated with nature"
            width="1200"
            height="788"
            fetchpriority="high"
            decoding="async"
            class="w-full h-auto object-cover aspect-[16/10.5]"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-zinc-950/70 via-zinc-950/20 to-transparent"></div>
          <div class="absolute bottom-5 left-5 right-5">
            <div class="text-xs uppercase tracking-[2px] text-emerald-300 font-medium">THE NEXT EVOLUTION</div>
            <div class="text-white text-xl font-semibold tracking-tight">Wealth that heals the planet.</div>
          </div>
        </div>
      </div>

      <!-- Scroll indicator -->
      <div class="absolute bottom-10 left-1/2 -translate-x-1/2 hidden lg:block">
        <div class="flex flex-col items-center text-xs tracking-[2px] text-zinc-300">
          <span>SCROLL TO EXPLORE</span>
          <Icon name="chevron-down" class="w-3.5 h-3.5 mt-1.5 animate-bounce" />
        </div>
      </div>
    </header>

    <!-- TRUST BAR -->
    <div class="border-b border-zinc-800 bg-zinc-900/60 py-5">
      <div class="max-w-screen-xl mx-auto px-6">
        <div class="flex flex-wrap justify-center md:justify-between items-center gap-x-8 gap-y-3 text-sm">
          {
            siteConfig.trustPoints.map((point) => (
              <div class="flex items-center gap-x-2 text-zinc-300">
                <Icon name="circle-check" class="w-4 h-4 text-emerald-400" />
                <span class="font-medium">{point}</span>
              </div>
            ))
          }
        </div>
      </div>
    </div>

    <!-- THE MEANING -->
    <section id="meaning" class="max-w-screen-xl mx-auto px-6 pt-20 pb-16">
      <div class="max-w-4xl mx-auto">
        <div class="max-w-3xl mx-auto text-center mb-14">
          <div class="inline-block px-4 py-1 rounded-3xl bg-emerald-500/10 text-emerald-400 text-xs font-bold tracking-[2px] mb-6">THE NAME</div>
          <h2 class="section-header tracking-[-2.5px] mb-4">Ecocryptoworld means<br /><span class="eco-gradient">Eco Crypto World</span></h2>
          <p class="text-xl text-zinc-400 max-w-2xl mx-auto">The complete ecosystem where cryptocurrency meets sustainability, regeneration, and planetary-scale positive impact.</p>
        </div>

        <div class="grid md:grid-cols-2 gap-8 items-center">
          <div>
            <div class="prose prose-invert prose-lg max-w-none text-zinc-300">
              <p class="leading-relaxed"><strong class="text-white">"Eco Crypto World"</strong> is a clear, ambitious, and highly descriptive name that instantly communicates the convergence of two of the most important movements of our time:</p>
              <ul class="mt-4 space-y-2">
                <li class="flex items-start gap-x-3"><span class="text-emerald-400 mt-1">•</span> <span><strong>Cryptocurrency & Blockchain</strong> — the new rails of global finance and ownership</span></li>
                <li class="flex items-start gap-x-3"><span class="text-emerald-400 mt-1">•</span> <span><strong>Ecology & Regeneration</strong> — the urgent need to heal our planet while creating prosperity</span></li>
              </ul>
            </div>

            <ul class="mt-6 space-y-3 text-lg">
              <li class="flex items-start gap-x-3">
                <Icon name="circle-check" class="w-4 h-4 text-emerald-400 mt-1.5 flex-shrink-0" />
                <span><strong>Clear & Descriptive</strong> — No explanation needed. The name tells the story.</span>
              </li>
              <li class="flex items-start gap-x-3">
                <Icon name="circle-check" class="w-4 h-4 text-emerald-400 mt-1.5 flex-shrink-0" />
                <span><strong>Global & Inclusive</strong> — Appeals to climate-conscious users, institutions, and impact investors worldwide.</span>
              </li>
              <li class="flex items-start gap-x-3">
                <Icon name="circle-check" class="w-4 h-4 text-emerald-400 mt-1.5 flex-shrink-0" />
                <span><strong>Platform-Scale Ambition</strong> — "World" suggests a comprehensive ecosystem, not just a single product.</span>
              </li>
              <li class="flex items-start gap-x-3">
                <Icon name="circle-check" class="w-4 h-4 text-emerald-400 mt-1.5 flex-shrink-0" />
                <span><strong>Future-Proof Narrative</strong> — Positions the brand at the forefront of ReFi, climate finance, and sustainable blockchain.</span>
              </li>
            </ul>
          </div>

          <div class="bg-zinc-900 border border-zinc-800 rounded-3xl p-8 md:p-10">
            <div class="text-sm uppercase tracking-[2px] text-zinc-400 mb-4">POWERFUL POSITIONING</div>
            <div class="space-y-6 text-lg">
              <div>
                <div class="font-mono text-xs text-emerald-400 tracking-widest mb-1">THE CONVERGENCE</div>
                <div class="text-2xl font-semibold tracking-tight leading-tight">Crypto + Ecology =<br />The most important story of the next decade</div>
              </div>
              <div class="pt-4 border-t border-zinc-700 text-zinc-400">
                Ecocryptoworld.com gives you instant ownership of one of the clearest and most compelling narratives in technology and finance today.
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- THE OPPORTUNITY -->
    <section id="opportunity" class="bg-zinc-900 border-y border-zinc-800 py-20">
      <div class="max-w-screen-xl mx-auto px-6">
        <div class="max-w-3xl mx-auto text-center mb-14">
          <div class="inline-block px-4 py-1 rounded-3xl bg-emerald-500/10 text-emerald-400 text-xs font-bold tracking-[2px] mb-6">THE NEW WEALTH PARADIGM</div>
          <h2 class="section-header tracking-[-2.5px] mb-4">Crypto wealth creation<br />that also <span class="eco-gradient">heals the planet</span>.</h2>
        </div>

        <div class="max-w-4xl mx-auto">
          <div class="prose prose-invert prose-lg max-w-none text-zinc-300">
            <p class="text-xl leading-relaxed">With the advent of cryptocurrency, we gained the ability to create enormous wealth from anywhere in the world. Now, the next evolution is here: the ability to generate that wealth while actively regenerating ecosystems, reducing carbon, and building a more sustainable future.</p>

            <p class="mt-6">Regenerative Finance (ReFi), on-chain carbon markets, tokenized renewable energy, biodiversity credits, and transparent sustainable supply chains are no longer niche ideas — they are rapidly becoming major capital flows. Institutions, governments, and millions of individuals want to participate in crypto that does good.</p>

            <p class="mt-6">The brands that will dominate this next chapter are those that clearly and credibly own the intersection of <strong class="text-white">crypto and ecology</strong>. Ecocryptoworld.com is that name.</p>
          </div>

          <div class="mt-10 grid grid-cols-2 md:grid-cols-4 gap-4">
            <div class="bg-zinc-950 border border-zinc-800 rounded-2xl p-5 text-center reason-card">
              <div class="text-2xl md:text-4xl font-semibold text-white tracking-tighter stat-number">ReFi</div>
              <div class="text-sm text-zinc-400 mt-1">Explosive Growth</div>
            </div>
            <div class="bg-zinc-950 border border-zinc-800 rounded-2xl p-5 text-center reason-card">
              <div class="text-2xl md:text-4xl font-semibold text-white tracking-tighter stat-number">Carbon</div>
              <div class="text-sm text-zinc-400 mt-1">On-Chain Markets</div>
            </div>
            <div class="bg-zinc-950 border border-zinc-800 rounded-2xl p-5 text-center reason-card">
              <div class="text-2xl md:text-4xl font-semibold text-white tracking-tighter stat-number">ESG</div>
              <div class="text-sm text-zinc-400 mt-1">Institutional Capital</div>
            </div>
            <div class="bg-zinc-950 border border-zinc-800 rounded-2xl p-5 text-center reason-card">
              <div class="text-2xl md:text-4xl font-semibold text-white tracking-tighter stat-number">Impact</div>
              <div class="text-sm text-zinc-400 mt-1">Measurable & Verifiable</div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- WHY THIS DOMAIN COMMANDS PREMIUM VALUE -->
    <section id="why-premium" class="max-w-screen-xl mx-auto px-6 pt-20 pb-16">
      <div class="max-w-3xl mx-auto text-center mb-14">
        <div class="inline-block px-4 py-1 rounded-3xl bg-emerald-500/10 text-emerald-400 text-xs font-bold tracking-[2px] mb-4">PREMIUM STRATEGIC ASSET</div>
        <h2 class="section-header tracking-[-2.5px]">Why Ecocryptoworld.com<br />commands a <span class="eco-gradient">high acquisition price</span></h2>
        <p class="mt-5 text-xl text-zinc-400">This is one of the clearest, most timely, and most ownable names at the intersection of crypto and sustainability.</p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 max-w-6xl mx-auto">
        {
          reasons.map((reason) => (
            <div class="reason-card bg-zinc-900 border border-zinc-800 rounded-3xl p-8 flex flex-col">
              <div class="w-12 h-12 flex items-center justify-center rounded-2xl eco-glow bg-opacity-10 mb-6">
                <span class="text-2xl font-extrabold font-display text-zinc-950">{String(reason.data.number).padStart(2, '0')}</span>
              </div>
              <h3 class="font-semibold text-xl tracking-tight mb-3">{reason.data.title}</h3>
              <p class="text-zinc-400 leading-relaxed flex-grow">{reason.data.description}</p>
            </div>
          ))
        }
      </div>

      <div class="max-w-3xl mx-auto mt-12 text-center text-sm text-zinc-400 border-t border-zinc-800 pt-8">
        In a market where clear, narrative-rich, and purpose-driven domains in high-growth sectors command significant premiums, Ecocryptoworld.com stands out as one of the most ownable and strategically powerful names available at the intersection of crypto and sustainability.
      </div>
    </section>

    <!-- USE CASES -->
    <section id="use-cases" class="bg-zinc-900 border-y border-zinc-800 py-20">
      <div class="max-w-screen-xl mx-auto px-6">
        <div class="max-w-3xl mx-auto text-center mb-14">
          <div class="inline-block px-4 py-1 rounded-3xl bg-emerald-500/10 text-emerald-400 text-xs font-bold tracking-[2px] mb-4">BUILT FOR IMPACT + SCALE</div>
          <h2 class="section-header tracking-[-2.5px]">Perfect for the future of<br />regenerative crypto</h2>
          <p class="mt-5 text-xl text-zinc-400 max-w-md mx-auto">This name gives you instant credibility and positioning in one of crypto's most important emerging sectors.</p>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 max-w-6xl mx-auto">
          {
            siteConfig.useCaseCategories.map((useCase, i) => (
              <div class="use-case-card bg-zinc-950 border border-zinc-800 hover:border-emerald-400/40 rounded-3xl p-8 flex flex-col">
                <div class="flex items-center gap-x-4 mb-5">
                  <div class="w-11 h-11 rounded-2xl eco-glow flex items-center justify-center flex-shrink-0">
                    <span class="text-zinc-950 font-bold text-lg">{i + 1}</span>
                  </div>
                  <div>
                    <div class="font-semibold text-lg tracking-tight">{useCase.title}</div>
                  </div>
                </div>
                <p class="text-zinc-400 flex-grow text-[15px] leading-relaxed">{useCase.description}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- THIS IS MORE THAN A DOMAIN -->
    <section class="max-w-screen-xl mx-auto px-6 py-20">
      <div class="max-w-4xl mx-auto text-center">
        <div class="mx-auto mb-8 inline-flex items-center justify-center w-20 h-20 rounded-full bg-white/5 border border-white/10">
          <Icon name="globe" class="w-10 h-10 eco-gradient" />
        </div>

        <h2 class="font-display text-5xl md:text-6xl tracking-[-2.5px] leading-none font-extrabold mb-6">
          This Is More Than a Domain —<br />
          <span class="eco-gradient">It's a Movement</span>
        </h2>

        <div class="prose prose-invert prose-lg max-w-2xl mx-auto text-zinc-300 space-y-4">
          <p>
            In a digital landscape crowded with generic names and forgettable handles, <strong class="text-white">ecocryptoworld.com</strong> stands apart. It positions its owner as mission-driven, forward-leaning, and strategically fluent from the first impression.
          </p>
          <p>
            Whether you are the protocol founder ready to claim the ReFi narrative at scale, the entrepreneur building the central platform for sustainable crypto, or the investor who recognizes long-term brand equity in the climate-tech convergence, this domain is ready to serve as the cornerstone.
          </p>
        </div>
      </div>
    </section>

    <!-- ACQUISITION SECTION -->
    <section class="bg-zinc-900 border-y border-zinc-800 py-16">
      <div class="max-w-screen-xl mx-auto px-6">
        <div class="max-w-4xl mx-auto">
          <div class="text-center mb-10">
            <div class="inline-block px-5 py-1.5 rounded-3xl bg-emerald-500/10 text-emerald-400 text-xs font-extrabold tracking-[1.5px] mb-4">ACQUISITION</div>
            <h2 class="section-header tracking-[-2px]">Ready to build<br />the Eco Crypto World?</h2>
          </div>

          <div class="bg-zinc-950 border border-zinc-700 rounded-3xl p-10 md:p-14">
            <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-y-8">
              <div>
                <div class="text-sm uppercase tracking-[3px] text-emerald-400 font-bold mb-2">Premium Strategic Asset</div>
                <div class="flex items-baseline gap-x-3 flex-wrap">
                  <span class="text-5xl font-extrabold tabular-nums tracking-[-2px] text-white">{DOMAIN_PRICE.display}</span>
                  <span class="text-lg font-semibold text-emerald-400 tabular-nums">USD</span>
                </div>
                <div class="text-sm text-zinc-300 mt-1">Asking price • Reasonable offers considered</div>

                <div class="mt-6 space-y-2">
                  <div class="flex justify-between items-center py-1 border-b border-zinc-800 text-sm">
                    <span class="text-zinc-400">Domain</span>
                    <span class="font-mono font-medium text-white break-all">ecocryptoworld.com</span>
                  </div>
                  <div class="flex justify-between items-center py-1 border-b border-zinc-800 text-sm">
                    <span class="text-zinc-400">Extension</span>
                    <span class="font-medium">.com (Premium)</span>
                  </div>
                  <div class="flex justify-between items-center py-1 border-b border-zinc-800 text-sm">
                    <span class="text-zinc-400">Positioning</span>
                    <span class="font-medium">High-Impact / Platform Brand</span>
                  </div>
                </div>
              </div>

              <div class="lg:text-right">
                <AcquisitionCTA label="Make an offer" variant="accent" icon="arrow-right" href="#offer" />
                <div class="mt-4 text-xs text-zinc-300">Serious buyers only • Escrow protected</div>
              </div>
            </div>

            <div class="mt-10 pt-8 border-t border-zinc-700 grid grid-cols-1 sm:grid-cols-3 gap-y-6 text-sm">
              <div>
                <div class="font-semibold mb-1 flex items-center gap-x-2"><Icon name="handshake" class="w-4 h-4 text-emerald-400" /> <span>Transaction</span></div>
                <div class="text-zinc-400">Handled via Escrow.com or your preferred platform. Full domain push + DNS control transfer.</div>
              </div>
              <div>
                <div class="font-semibold mb-1 flex items-center gap-x-2"><Icon name="file-contract" class="w-4 h-4 text-emerald-400" /> <span>Confidential</span></div>
                <div class="text-zinc-400">All inquiries are handled confidentially. Pricing reflects brand strength, keyword alignment, cultural timing, versatility, and long-term appreciation potential.</div>
              </div>
              <div>
                <div class="font-semibold mb-1 flex items-center gap-x-2"><Icon name="globe" class="w-4 h-4 text-emerald-400" /> <span>Why Now?</span></div>
                <div class="text-zinc-400">The brands that claim clear, ownable language around the ReFi + climate finance convergence now will hold mindshare for years.</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <FAQ faqs={siteConfig.faqs} />

    <!-- OFFER FORM -->
    <OfferForm />

    <!-- FINAL CTA -->
    <div class="bg-gradient-to-b from-zinc-900 to-zinc-950 py-16">
      <div class="max-w-screen-xl mx-auto px-6 text-center">
        <div class="max-w-lg mx-auto">
          <div class="inline-flex items-center justify-center w-16 h-16 rounded-3xl bg-gradient-to-br from-emerald-500 to-emerald-600 mb-6 shadow-inner">
            <Icon name="globe" class="w-8 h-8 text-zinc-950" />
          </div>
          <h3 class="font-display text-4xl sm:text-5xl tracking-[-1.5px] sm:tracking-[-2px] font-extrabold mb-4">Wealth that<br />heals the planet.</h3>
          <p class="text-xl text-zinc-300 mb-8">Ecocryptoworld.com is available for private acquisition by ambitious teams building the future of regenerative finance and sustainable blockchain.</p>

          <AcquisitionCTA label="Email the owner" variant="accent" icon="envelope" />
          <p class="mt-4 text-xs text-zinc-400">Serious inquiries only. Pricing and terms confirmed in writing before escrow opens.</p>
        </div>
      </div>
    </div>
  </main>

  <Footer disclaimer={siteConfig.disclaimer} />
  <StickyCta />
</BaseLayout>
