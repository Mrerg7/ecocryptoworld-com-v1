---
import { getEntry } from 'astro:content';
import { DOMAIN_PRICE, SITE } from '../consts';
import { getCanonicalUrl } from '../lib/canonical';

interface Props {
  title?: string;
  description?: string;
  path?: string;
}

const {
  title = SITE.title,
  description = SITE.description,
  path = '/',
} = Astro.props;

const canonical = getCanonicalUrl(path);

const OG_IMAGE = 'https://imagedelivery.net/-sPAUAWeA405NiWJ0SNIQA/d7753631-936b-4121-4c3f-fa95f9393600/public';

const siteEntry = await getEntry('site', 'default');
const faqs = siteEntry?.data.faqs ?? [];

const jsonLd: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE.name,
    alternateName: 'Eco Crypto World',
    url: SITE.url,
    description,
    inLanguage: 'en-US',
    publisher: {
      '@id': `${SITE.url}#organization`,
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: `${SITE.name} — Premium Domain Name`,
    description,
    url: SITE.url,
    category: 'Domain Name',
    brand: {
      '@type': 'Brand',
      name: 'Eco Crypto World',
    },
    offers: {
      '@type': 'Offer',
      url: SITE.url,
      price: DOMAIN_PRICE.amount,
      priceCurrency: DOMAIN_PRICE.currency,
      availability: 'https://schema.org/InStock',
      validFrom: '2025-01-01T00:00:00-08:00',
      priceValidUntil: '2027-12-31T23:59:59-08:00',
      seller: {
        '@type': 'Organization',
        name: 'Desert Rich',
        email: SITE.acquisitionEmail,
      },
      hasMerchantReturnPolicy: {
        '@type': 'MerchantReturnPolicy',
        returnPolicyCategory: 'https://schema.org/MerchantReturnNotPermitted',
        returnMethod: 'https://schema.org/ReturnByMail',
        applicableCountry: 'US',
        merchantReturnDays: 0,
      },
      shippingDetails: {
        '@type': 'OfferShippingDetails',
        shippingRate: {
          '@type': 'MonetaryAmount',
          value: 0,
          currency: DOMAIN_PRICE.currency,
        },
        deliveryTime: {
          '@type': 'ShippingDeliveryTime',
          handlingTime: {
            '@type': 'QuantitativeValue',
            minValue: 1,
            maxValue: 3,
            unitCode: 'd',
          },
          transitTime: {
            '@type': 'QuantitativeValue',
            minValue: 0,
            maxValue: 0,
            unitCode: 'd',
          },
        },
        shippingDestination: {
          '@type': 'DefinedRegion',
          addressCountry: 'US',
        },
      },
    },
    image: OG_IMAGE,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': `${SITE.url}#organization`,
    name: SITE.name,
    alternateName: 'Eco Crypto World',
    url: SITE.url,
    logo: OG_IMAGE,
    contactPoint: {
      '@type': 'ContactPoint',
      contactType: 'sales',
      email: SITE.acquisitionEmail,
      availableLanguage: 'English',
    },
  },
];

if (faqs.length > 0 && path === '/') {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: faq.answer,
      },
    })),
  });
}
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<link rel="canonical" href={canonical} />
<title>{title}</title>
<meta name="description" content={description} />
<meta
  name="robots"
  content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1"
/>
<meta name="theme-color" content="#09090b" />
<meta name="google-site-verification" content="F5DW1RsF6P0F4EHRP_Eu7CB3AhDpymRxkmLFnW8NLlQ" />
<meta name="author" content="Desert Rich" />

<meta property="og:type" content="website" />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:locale" content={SITE.locale} />
<meta property="og:image" content={OG_IMAGE} />
<meta property="og:image:secure_url" content={OG_IMAGE} />
<meta property="og:image:alt" content={`${SITE.name} — Premium domain for the Eco Crypto World movement`} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={OG_IMAGE} />
<meta name="twitter:image:alt" content={`${SITE.name} — Premium domain for the Eco Crypto World movement`} />

<link rel="icon" href="/favicon.svg" type="image/svg+xml" />

<link rel="preconnect" href="https://imagedelivery.net" />

<link
  rel="preload"
  href="/fonts/space-grotesk-latin.woff2"
  as="font"
  type="font/woff2"
  crossorigin
/>
<link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />

<script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
