---
import { ACQUISITION_MAILTO } from '../consts';
import Icon from './Icon.astro';

const links = [
  { href: '#meaning', label: 'The Name' },
  { href: '#opportunity', label: 'The Opportunity' },
  { href: '#why-premium', label: 'Why Premium' },
  { href: '#faq', label: 'FAQ' },
];
---

<nav id="nav" class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 border-b border-zinc-800">
  <div class="max-w-screen-xl mx-auto">
    <div class="px-6 py-5 flex items-center justify-between">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-x-3 no-underline min-w-0 py-1">
        <div class="w-9 h-9 shrink-0 eco-glow rounded-xl flex items-center justify-center shadow-inner">
          <Icon name="leaf" class="w-[1.125rem] h-[1.125rem] text-zinc-950" />
        </div>
        <div class="min-w-0">
          <span class="font-display text-[1.25rem] md:text-2xl font-semibold tracking-tighter text-white whitespace-nowrap">Ecocryptoworld</span>
          <span class="text-xs font-mono text-zinc-400 align-super ml-0.5">.COM</span>
        </div>
      </a>

      <!-- Desktop Nav -->
      <div class="hidden md:flex items-center gap-x-8 text-sm font-medium">
        {
          links.map((link) => (
            <a href={link.href} class="nav-link text-zinc-300 hover:text-emerald-400 no-underline">
              {link.label}
            </a>
          ))
        }
      </div>

      <!-- CTA Buttons -->
      <div class="flex items-center gap-x-3">
        <a
          href="#offer"
          class="hidden md:inline-flex px-5 lg:px-6 py-2.5 eco-glow hover:brightness-110 active:brightness-95 transition-all text-zinc-950 text-sm font-semibold rounded-3xl items-center gap-x-2 shadow-lg shadow-emerald-500/20 no-underline"
        >
          <span>Make an offer</span>
          <Icon name="arrow-right" class="w-3 h-3" />
        </a>

        <!-- Mobile Menu Button -->
        <button
          id="mobile-menu-btn"
          class="md:hidden w-11 h-11 flex items-center justify-center text-zinc-300 hover:text-white bg-transparent border-0 cursor-pointer"
          aria-label="Open menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <Icon name="bars" class="w-5 h-5" />
        </button>
      </div>
    </div>
  </div>
</nav>

<script>
  import { ACQUISITION_MAILTO } from '../consts';

  const nav = document.getElementById('nav');
  window.addEventListener('scroll', () => {
    if (window.scrollY > 30) {
      nav?.classList.add('nav-scrolled', 'shadow-xl');
    } else {
      nav?.classList.remove('nav-scrolled', 'shadow-xl');
    }
  });

  const mobileBtn = document.getElementById('mobile-menu-btn');
  if (mobileBtn) {
    mobileBtn.addEventListener('click', () => {
      const navLinks = document.createElement('div');
      navLinks.id = 'mobile-menu';
      navLinks.className = 'fixed inset-0 bg-zinc-950/95 z-[90] flex flex-col p-8 pt-20 text-xl';
      navLinks.innerHTML = `
        <button type="button" class="absolute top-6 right-8 text-4xl leading-none text-zinc-300 bg-transparent border-0 cursor-pointer" aria-label="Close menu">&times;</button>
        <a href="#meaning" class="py-4 border-b border-zinc-800 text-zinc-200 no-underline">The Name</a>
        <a href="#opportunity" class="py-4 border-b border-zinc-800 text-zinc-200 no-underline">The Opportunity</a>
        <a href="#why-premium" class="py-4 border-b border-zinc-800 text-zinc-200 no-underline">Why Premium</a>
        <a href="#faq" class="py-4 border-b border-zinc-800 text-zinc-200 no-underline">FAQ</a>
        <div class="pt-8">
          <a href="#offer"
             class="block w-full py-4 eco-glow text-zinc-950 rounded-3xl font-semibold text-center no-underline">
            Make an offer
          </a>
          <a href="${ACQUISITION_MAILTO}"
             class="block w-full mt-3 py-4 border border-zinc-700 text-zinc-200 rounded-3xl font-semibold text-center no-underline text-base">
            Email sales@desertrich.com
          </a>
        </div>
      `;
      document.body.appendChild(navLinks);
      mobileBtn.setAttribute('aria-expanded', 'true');

      const close = () => {
        if (document.body.contains(navLinks)) document.body.removeChild(navLinks);
        mobileBtn.setAttribute('aria-expanded', 'false');
      };

      navLinks.querySelector('button')?.addEventListener('click', close);

      navLinks.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => {
          setTimeout(close, 300);
        });
      });

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') close();
      });
    });
  }
</script>
