---
interface Props {
  faqs: { question: string; answer: string }[];
}

const { faqs } = Astro.props;
---

<section id="faq" class="max-w-screen-xl mx-auto px-6 py-16 md:py-20">
  <div class="max-w-4xl mx-auto">
    <div class="text-center mb-12">
      <div
        class="inline-block px-4 py-1 rounded-3xl bg-emerald-500/10 text-emerald-400 text-xs font-bold tracking-[2px] mb-6"
      >
        BUYER QUESTIONS
      </div>
      <h2 class="section-header tracking-[-2.5px]">Everything buyers ask<br />before <span class="eco-gradient">closing</span></h2>
      <p class="mt-5 text-xl text-zinc-400">
        Straight answers on price, escrow, transfer, and timing — before you ever open a thread.
      </p>
    </div>

    <div class="space-y-4">
      {
        faqs.map((faq, i) => (
          <details
            class="group bg-zinc-900 border border-zinc-800 rounded-2xl open:border-emerald-500/40 transition-colors"
            open={i === 0}
          >
            <summary class="flex items-start justify-between gap-x-4 cursor-pointer list-none px-6 py-5 text-base sm:text-lg font-semibold text-white select-none [&::-webkit-details-marker]:hidden">
              <span class="flex gap-x-3">
                <span class="text-emerald-400 font-mono text-sm mt-1">{String(i + 1).padStart(2, '0')}</span>
                <span>{faq.question}</span>
              </span>
              <span class="text-emerald-400 shrink-0 mt-1 transition-transform group-open:rotate-45">
                +
              </span>
            </summary>
            <p class="px-6 pb-6 pl-[3.75rem] text-zinc-400 leading-relaxed">{faq.answer}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>
